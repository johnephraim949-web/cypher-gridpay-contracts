{
  "name": "@cypher-gridpay/crank-worker",
  "version": "0.1.0",
  "description": "Off-chain scheduled execution and subscription dunning crank worker for Cypher GridPay Soroban contracts",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "sql",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "test:integration": "npm run build && node --test test/integration.quickstart.test.mjs",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^17.4.0",
    "pg": "^8.13.1",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.11.10",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/johnephraim949-web/cypher-gridpay-contracts.git",
    "directory": "services/crank-worker"
  }
}
