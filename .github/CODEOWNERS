# CODEOWNERS — Cypher GridPay
# https://docs.github.com/en/repositories/managing-your-repositorys-settings-and-features/customizing-your-repository/about-code-owners
#
# Ownership rules are evaluated top-to-bottom; the LAST matching pattern wins.
# More specific rules are therefore placed after broader ones.
#
# NOTE: Teams referenced below (e.g. @cypher-gridpay/...) must exist in the
# organization and have write access for the rule to take effect.

# ---------------------------------------------------------------------------
# Default owners for everything in the repository
# ---------------------------------------------------------------------------
*                                   @cypher-gridpay/maintainers

# ---------------------------------------------------------------------------
# Smart Contracts (security-sensitive)
# ---------------------------------------------------------------------------
/core/contracts/                    @cypher-gridpay/smart-contracts @cypher-gridpay/security
/core/contracts/**                  @cypher-gridpay/smart-contracts @cypher-gridpay/security
/contracts/                         @cypher-gridpay/smart-contracts @cypher-gridpay/security
/contracts/**                       @cypher-gridpay/smart-contracts @cypher-gridpay/security

# ---------------------------------------------------------------------------
# Orchestrator (security-sensitive)
# ---------------------------------------------------------------------------
/orchestrator/                      @cypher-gridpay/orchestrator @cypher-gridpay/security
/orchestrator/**                    @cypher-gridpay/orchestrator @cypher-gridpay/security

# ---------------------------------------------------------------------------
# SDKs
